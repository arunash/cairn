# Cairn — local config. Copy to `.env`. This file stays on YOUR machine; never commit .env.

# Your Robinhood login (stored locally; used to authenticate the local read-only agent)
RH_USERNAME=
RH_PASSWORD=

# Optional — scheduled email alerts (concentration-trim watcher, earnings, reminders)
ALERT_EMAIL=
GMAIL_APP_PASSWORD_FILE=~/.cairn/gmail_app_password.txt

# Act mode (advanced) — leave off for read-only Insights + Chat.
# Set to 1 ONLY when you want the agent to place trades (still approves every order).
CAIRN_ACT_ENABLED=0
